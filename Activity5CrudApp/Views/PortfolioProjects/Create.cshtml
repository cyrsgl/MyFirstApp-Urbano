@model Activity4FrontendApp.Models.PortfolioProject

@{
    ViewData["Title"] = "Add New Record";
}

<h1>Add New Record</h1>

<form asp-action="Create" method="post">
    <div class="form-group mb-3">
        <label asp-for="Name">Project Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Technology">Technology Used</label>
        <input asp-for="Technology" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="ProjectLink">Project Link</label>
        <input asp-for="ProjectLink" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Save Record</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>