@model Activity4FrontendApp.Models.PortfolioProject

@{
    ViewData["Title"] = "Delete Record";
}

<h1>Delete Record</h1>

<h3>Are you sure you want to delete this record?</h3>

<div class="card">
    <div class="card-body">
        <p><strong>Project Name:</strong> @Model.Name</p>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Technology:</strong> @Model.Technology</p>
        <p><strong>Project Link:</strong> @Model.ProjectLink</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
